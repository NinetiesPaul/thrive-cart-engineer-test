{
  "compilerOptions": {
    "target": "ES2019",
    "module": "None",
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "rootDir": "src/ts",
    "outDir": "includes/js",
    "types": ["jquery"],
    "removeComments": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*.ts"]
}
